# Template for local development. Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored — never commit secrets.
# .env.example is committed as the documented contract of what env vars exist.
#
# Loading: backend/app.py and scripts/precompute_verdicts.py call load_dotenv()
# at startup, so any value here is auto-loaded when you run them. No manual
# sourcing needed:
#     uv run uvicorn backend.app:app --port 8001       # ← reads .env
#     uv run python scripts/precompute_verdicts.py     # ← reads .env
#
# Platform precedence: load_dotenv does NOT override existing env vars, so
# Railway/Vercel/Docker-injected vars take precedence in production.

# ─── Backend mode ─────────────────────────────────────────────────────────
# scenario  - cached scenarios only (no API key needed at runtime)
# decoder   - live custom prompts only (needs GPU_URL + ANTHROPIC_API_KEY)
# hybrid    - BOTH cached + live (recommended for demo/production)
# mock      - dev/CI stub (no GPU, no judge)
ORCHESTRATOR_GPU=hybrid

# ─── GPU (live path) ──────────────────────────────────────────────────────
# Required when mode in {decoder, hybrid}. Pointing at the GPU running
# gpu/server.py with POST /generate (vast.ai).
GPU_URL=http://193.222.57.16:44016
GPU_TIMEOUT=120

# ─── Anthropic (live judge + offline precompute) ──────────────────────────
# Required by:
#   - scripts/precompute_verdicts.py (offline judge run, fills artifact verdicts)
#   - ClaudeAgentJudge in live mode (decoder/hybrid mode at runtime)
# Scenario mode does NOT need this at runtime — verdicts are cached on disk.
ANTHROPIC_API_KEY=sk-ant-...
JUDGE_MODEL=claude-sonnet-4-6
JUDGE_PROMPT_VERSION=v2-2026-05-10

# ─── Scenarios (cached path) ──────────────────────────────────────────────
# Required when mode in {scenario, hybrid}.
SCENARIO_DIR=./demo_data
SCENARIO_MANIFEST=manifest.yaml

# ─── Misc ─────────────────────────────────────────────────────────────────
# CORS: set to your Vercel domain in production. * is fine in local dev.
CORS_ORIGINS=*
MAX_NEW_TOKENS=128
