# Template for local development. Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored — never commit secrets.
# .env.example is committed as the documented contract of what env vars exist.
#
# Loading: backend/app.py and scripts/precompute_verdicts.py call load_dotenv()
# at startup, so any value here is auto-loaded when you run them. No manual
# sourcing needed:
#     uv run uvicorn backend.app:app --port 8001       # ← reads .env
#     uv run python scripts/precompute_verdicts.py     # ← reads .env
#
# Platform precedence: load_dotenv does NOT override existing env vars, so
# Railway/Vercel/Docker-injected vars take precedence in production.

# ─── Anthropic (judge) ────────────────────────────────────────────────────
# Required by:
#   - scripts/precompute_verdicts.py (offline judge run, sat night)
#   - ClaudeJudge in live mode (only when JUDGE_BACKEND=claude)
# Demo (scenario mode) does NOT need this at runtime — verdicts are cached.
ANTHROPIC_API_KEY=sk-ant-...

# ─── GPU (only for live decode mode, NOT for the demo) ────────────────────
# Demo mode (ORCHESTRATOR_GPU=scenario) does NOT use this.
# Required only when ORCHESTRATOR_GPU=decoder (e.g., to run a fresh /decode
# against the real Qwen + NLA actor on vast.ai).
GPU_URL=http://193.222.57.16:44016
GPU_SKIP_FIRST=10
GPU_TIMEOUT=120

# ─── Backend behavior ─────────────────────────────────────────────────────
# Demo: scenario      (cached artifacts, no GPU dependency at runtime)
# Live: decoder       (hits real GPU /decode)
# Dev:  mock          (canned tokens, no GPU at all)
ORCHESTRATOR_GPU=scenario

# Judge backend used by the LIVE flow (per-monologue regex/Claude).
# Scenario mode bypasses this — turn-level verdicts are cached.
# regex   = no API key needed, fast
# claude  = uses ANTHROPIC_API_KEY
JUDGE_BACKEND=regex
JUDGE_MODEL=claude-haiku-4-5

# CORS — set to your Vercel domain in production. * is fine in local dev.
CORS_ORIGINS=*

# Optional, only matters for ORCHESTRATOR_GPU=scenario:
SCENARIO_DIR=./demo_data
SCENARIO_MANIFEST=manifest.yaml
